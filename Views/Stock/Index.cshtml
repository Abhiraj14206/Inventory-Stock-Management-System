@model IEnumerable<StockMovement>
@{ ViewData["Title"] = "Stock movements"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h1 class="h2 fw-bold">Stock movements</h1><a asp-action="Create" class="btn btn-primary">+ Record movement</a></div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Date</th><th>Product</th><th>Type</th><th>Quantity</th><th>Notes</th></tr></thead><tbody>
@foreach (var m in Model) { <tr><td>@m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@m.Product?.Name</td><td><span class="badge @(m.Type == "IN" ? "bg-success" : "bg-warning text-dark")">@(m.Type == "IN" ? "Stock In" : "Stock Out")</span></td><td>@m.Quantity</td><td>@m.Notes</td></tr> }
@if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No stock movements yet.</td></tr> }
</tbody></table></div></div>
