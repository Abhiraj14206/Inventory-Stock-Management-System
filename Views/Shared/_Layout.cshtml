<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - StockWise</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
 <div class="container"><a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">StockWise</a>
 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
 <div id="nav" class="collapse navbar-collapse"><div class="navbar-nav ms-auto">
 <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
 <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
 <a class="nav-link" asp-controller="Stock" asp-action="Index">Stock Movements</a>
 <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
 </div></div></div>
</nav>
<main class="container py-4">
 @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
 @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
 @RenderBody()
</main>
<footer class="border-top py-3 mt-5"><div class="container text-muted small">StockWise · ASP.NET Core MVC + EF Core + MySQL</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
