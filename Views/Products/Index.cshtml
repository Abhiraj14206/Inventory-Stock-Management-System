@model IEnumerable<Product>
@{ ViewData["Title"] = "Products"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h1 class="h2 fw-bold">Products</h1><a class="btn btn-primary" asp-action="Create">+ Add product</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-sm-8 col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search product or SKU" /></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button><a class="btn btn-link" asp-action="Index">Clear</a></div></form>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Name</th><th>SKU</th><th>Category</th><th>Unit price</th><th>Qty</th><th>Actions</th></tr></thead><tbody>
@foreach (var p in Model) { <tr><td class="fw-semibold">@p.Name</td><td>@p.SKU</td><td>@p.Category?.Name</td><td>₹@p.UnitPrice.ToString("N2")</td><td><span class="badge @(p.IsLowStock ? "bg-danger" : "bg-success")">@p.Quantity</span></td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">View</a> <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No products found.</td></tr> }
</tbody></table></div></div>
