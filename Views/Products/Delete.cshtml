@model Product
@{ ViewData["Title"] = "Delete product"; }
<h1 class="h2 fw-bold mb-3">Delete product</h1><div class="alert alert-warning">Are you sure you want to delete <strong>@Model.Name</strong>? Products with stock movement history cannot be deleted.</div><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger" type="submit">Confirm delete</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
